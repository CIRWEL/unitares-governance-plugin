# UNITARES Governance Plugin — Default Configuration
# These are fallbacks, not overrides. Explicit operator environment values
# must survive sourcing this file, including false-like values such as 0/off.
export UNITARES_SERVER_URL="${UNITARES_SERVER_URL:-http://localhost:8767}"
export UNITARES_AGENT_PREFIX="${UNITARES_AGENT_PREFIX:-claude}"

# --- Check-in emission (added 2026-04-17) ---

# Kill switch: set to 'off' to suppress every plugin-emitted check-in
# (Stop and Claude's edit-threshold auto-checkin).
export UNITARES_CHECKINS="${UNITARES_CHECKINS:-on}"

# Lazy onboarding: if a supported host turn ends before the agent manually calls
# start_session/onboard, post-stop creates a slot-scoped governance identity
# and submits the turn summary through the normal check-in path. Set this to
# off (or set legacy UNITARES_DISABLE_AUTO_ONBOARD=1) to retain floor-only
# behavior for un-onboarded sessions.
export UNITARES_AUTO_ONBOARD="${UNITARES_AUTO_ONBOARD:-on}"

# Diagnostic log: every check-in attempt writes one line here with status.
# Tail this file to debug whether check-ins are landing.
export UNITARES_CHECKIN_LOG="${UNITARES_CHECKIN_LOG:-${HOME}/.unitares/checkins.log}"

# --- Edit-threshold auto-checkin (pre-existing) ---
# Fires a check-in after N edits OR T seconds since last check-in.
export UNITARES_AUTO_CHECKIN_ENABLED="${UNITARES_AUTO_CHECKIN_ENABLED:-1}"
export UNITARES_AUTO_CHECKIN_EDITS="${UNITARES_AUTO_CHECKIN_EDITS:-5}"
export UNITARES_AUTO_CHECKIN_SECS="${UNITARES_AUTO_CHECKIN_SECS:-600}"
export UNITARES_AUTO_CHECKIN_CLAIM_TTL_S="${UNITARES_AUTO_CHECKIN_CLAIM_TTL_S:-30}"
export UNITARES_MILESTONE_LOCK_TIMEOUT_S="${UNITARES_MILESTONE_LOCK_TIMEOUT_S:-2.0}"
export UNITARES_SESSION_CACHE_LOCK_TIMEOUT_S="${UNITARES_SESSION_CACHE_LOCK_TIMEOUT_S:-2.0}"
export UNITARES_WATCHER_ENABLED="${UNITARES_WATCHER_ENABLED:-0}"

# --- Session-start shared-memory recall ---
# Read-only, precision-or-silence KG context keyed to repo + branch. The helper
# suppresses low-confidence semantic-only hits and hollow memory mirrors.
export UNITARES_HOOK_KG_RECALL="${UNITARES_HOOK_KG_RECALL:-on}"
export UNITARES_HOOK_KG_RECALL_LIMIT="${UNITARES_HOOK_KG_RECALL_LIMIT:-3}"
export UNITARES_HOOK_KG_RECALL_TIMEOUT_S="${UNITARES_HOOK_KG_RECALL_TIMEOUT_S:-2.0}"
export UNITARES_HOOK_KG_RECALL_TTL_S="${UNITARES_HOOK_KG_RECALL_TTL_S:-3600}"

# --- Codex long-turn substrate liveness ---
# Every completed Codex PostToolUse event updates a local, identity-free slot
# ledger. The ledger says only that the Codex hook saw activity; it is not an
# agent check-in, EISV report, progress claim, or network observation.
export UNITARES_CODEX_LIVENESS="${UNITARES_CODEX_LIVENESS:-on}"
export UNITARES_CODEX_ACTIVITY_LOCK_TIMEOUT_S="${UNITARES_CODEX_ACTIVITY_LOCK_TIMEOUT_S:-1.0}"

# --- BEAM file leases for concurrent agents ---
# Claude Edit/Write/MultiEdit and Codex apply_patch acquire file:// leases.
# Missing LEASE_PLANE_BEARER_TOKEN or an unreachable lease plane fails open by
# default; real contention (held_by_other) blocks the edit. Set REQUIRED=1 to
# make missing/unreachable lease infrastructure block edits too. REQUIRED=1
# takes precedence over ENABLED=0 so fail-closed policy cannot be disabled by
# a stale or inherited opt-out.
export UNITARES_FILE_LEASES_ENABLED="${UNITARES_FILE_LEASES_ENABLED:-1}"
export UNITARES_FILE_LEASES_REQUIRED="${UNITARES_FILE_LEASES_REQUIRED:-0}"
export UNITARES_FILE_LEASE_TTL_S="${UNITARES_FILE_LEASE_TTL_S:-300}"
export UNITARES_FILE_LEASE_TIMEOUT_S="${UNITARES_FILE_LEASE_TIMEOUT_S:-1.0}"
export UNITARES_FILE_LEASE_BATCH_TIMEOUT_S="${UNITARES_FILE_LEASE_BATCH_TIMEOUT_S:-3.5}"
export LEASE_PLANE_BASE_URL="${LEASE_PLANE_BASE_URL:-http://127.0.0.1:8788}"

# --- Operator note on blocking ---
# SessionEnd is local cleanup only. Claude Stop is asynchronous. Codex Stop is
# synchronous but caps lazy onboarding at 5s and check-in transport at 15s
# inside its 30s hook. Codex activity recording is local and bounded by a
# three-second hook timeout. Set UNITARES_CHECKINS=off to skip network
# check-ins and dark-session floor observations.
