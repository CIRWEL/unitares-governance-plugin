#!/usr/bin/env bash
# UNITARES Governance Plugin — stop the detached Codex runtime observer.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "codex" || -t 0 ]]; then
  exit 0
fi

python3 "${PLUGIN_ROOT}/scripts/runtime_observer.py" stop >/dev/null 2>&1 || true
exit 0
