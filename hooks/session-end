#!/usr/bin/env bash
# UNITARES Governance Plugin — SessionEnd hook
#
# Fires when the host session terminates (window close, etc). Both hosts use
# this only for bounded local lease cleanup. Claude gives plugin-provided
# SessionEnd hooks a shared 1.5-second budget that a manifest timeout cannot
# raise, so turn-level governance delivery belongs to Stop instead.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi

PAYLOAD=$(cat 2>/dev/null || echo "{}")
[[ -z "${PAYLOAD}" ]] && PAYLOAD="{}"

# Release any file leases held by this host session. Run this before the
# deadline expires; PostToolUse and Stop are the primary release paths, while
# TTL remains the crash backstop.
FILE_LEASE_HELPER="${PLUGIN_ROOT}/scripts/file_lease_hook.py"
if [[ -f "${FILE_LEASE_HELPER}" ]]; then
  printf '%s' "${PAYLOAD}" | python3 "${FILE_LEASE_HELPER}" release-session \
    --workspace "${PWD}" --host "${HOOK_HOST}" --budget 0.8 >/dev/null 2>&1 || true
fi

exit 0
