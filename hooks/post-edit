#!/usr/bin/env bash
# UNITARES Governance Plugin — host-specific PostToolUse edit hook
#
# Responsibilities (in order):
#   1. Fan edit event out to an optional workspace-local watcher hook.
#   2. Bump the milestone accumulator (edit_count, files_touched, timestamps).
#   3. If edit_count or elapsed-since-last-checkin crosses a threshold, fire
#      process_agent_update against the governance server as a hook-driven
#      auto-checkin, then reset the accumulator.
#
# This revives the auto-checkin behavior that existed before commit e46f25d
# ("Align plugin with Codex packaging and runtime semantics"). That refactor
# stripped the per-edit curl but never replaced the forcing function, which
# left Claude in the same explicit-only mode as Codex even though Claude can
# drive richer hook behavior. Codex keeps its /checkin workflow untouched.
#
# Config (all optional):
#   UNITARES_AUTO_CHECKIN_ENABLED=0   — disable auto-checkin entirely
#   UNITARES_AUTO_CHECKIN_EDITS=5     — fire after N edits since last checkin
#   UNITARES_AUTO_CHECKIN_SECS=600    — fire after T seconds since last checkin
#                                       (combined with edit_count >= 1)
#   UNITARES_WATCHER_HOOK=<path>      — explicitly trusted watcher hook path
#   UNITARES_WATCHER_ENABLED=1        — opt in to watcher fan-out
#
# Claude runs this asynchronously and may auto-check in. Codex runs it
# synchronously, so its path stops after a local milestone update. Both hosts
# release leases through the separate synchronous post-edit-release handler.
# Neither path produces user-visible output on failure.
set -uo pipefail

# ---------------------------------------------------------------------------
# Resolve plugin root and helpers
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi

# Diagnostic breadcrumb (off by default). When UNITARES_HOOK_DEBUG=1, append
# one line per silent-exit so operators can see where the chain breaks
# without changing user-visible behavior. Path overridable via
# UNITARES_HOOK_DEBUG_LOG (default ~/.unitares/hook-skips.log).
_breadcrumb() {
  [[ "${UNITARES_HOOK_DEBUG:-0}" != "1" ]] && return 0
  local log="${UNITARES_HOOK_DEBUG_LOG:-${HOME}/.unitares/hook-skips.log}"
  local reason="$1"
  printf '%s | hook=post-edit | reason=%s | pwd=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" "$PWD" \
    >> "${log}" 2>/dev/null || true
}

SESSION_CACHE_HELPER=""
for candidate in \
  "${PLUGIN_ROOT}/scripts/session_cache.py" \
  "${PLUGIN_ROOT}/scripts/client/session_cache.py"
do
  if [[ -f "${candidate}" ]]; then
    SESSION_CACHE_HELPER="${candidate}"
    break
  fi
done

DEFAULTS_FILE=""
for candidate in \
  "${PLUGIN_ROOT}/config/defaults.env" \
  "${PLUGIN_ROOT}/config/client/defaults.env"
do
  if [[ -f "${candidate}" ]]; then
    DEFAULTS_FILE="${candidate}"
    break
  fi
done

SERVER_URL_OVERRIDE="${UNITARES_SERVER_URL-}"
if [[ -n "${DEFAULTS_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${DEFAULTS_FILE}" 2>/dev/null || true
fi
if [[ -n "${SERVER_URL_OVERRIDE}" ]]; then
  UNITARES_SERVER_URL="${SERVER_URL_OVERRIDE}"
fi
SERVER_URL="${UNITARES_SERVER_URL:-http://localhost:8767}"

# ---------------------------------------------------------------------------
# Read hook input from stdin (Claude passes tool info as JSON)
# ---------------------------------------------------------------------------
HOOK_INPUT=""
if [[ ! -t 0 ]]; then
  HOOK_INPUT=$(cat 2>/dev/null) || true
fi

# ---------------------------------------------------------------------------
# Optional workspace-local watcher fan-out
# ---------------------------------------------------------------------------
WATCHER_HOOK="${UNITARES_WATCHER_HOOK:-}"
if [[ "${HOOK_HOST}" == "claude" \
      && "${UNITARES_WATCHER_ENABLED:-0}" == "1" \
      && -n "${WATCHER_HOOK}" \
      && -x "${WATCHER_HOOK}" \
      && -n "${HOOK_INPUT}" ]]; then
  printf '%s' "${HOOK_INPUT}" | "${WATCHER_HOOK}" >/dev/null 2>&1 &
fi

# ---------------------------------------------------------------------------
# Require the local cache helper before recording an edit milestone
# ---------------------------------------------------------------------------
if [[ -z "${SESSION_CACHE_HELPER}" ]]; then
  _breadcrumb no_session_cache_helper
  exit 0
fi

# Slot derivation (S20.1a): SLOT is strictly the host session_id
# from hook stdin. When stdin lacks session_id, the entire auto-checkin
# pipeline is a full no-op: no checkin.py call, no milestone reset, and no
# last_checkin_ts stamp. This avoids threshold flapping and prevents stale
# flat-cache slot fields from becoming write targets.
SLOT_HELPER="${PLUGIN_ROOT}/scripts/_slot_from_stdin.py"
SLOT=""
if [[ -n "${HOOK_INPUT}" && -f "${SLOT_HELPER}" ]]; then
  SLOT=$(printf '%s' "${HOOK_INPUT}" | python3 "${SLOT_HELPER}" 2>/dev/null || true)
fi
if [[ -z "${SLOT}" ]]; then
  printf '[SLOTLESS_SKIP] post-edit: no session_id on stdin; auto-checkin pipeline not run\n' >&2
  _breadcrumb slotless_skip
  exit 0
fi

# ---------------------------------------------------------------------------
# Normalize host-specific edit paths through the shared adapter contract
# ---------------------------------------------------------------------------
EDIT_EVENT_HELPER="${PLUGIN_ROOT}/scripts/edit_hook_event.py"
if [[ ! -f "${EDIT_EVENT_HELPER}" ]]; then
  _breadcrumb no_edit_event_helper
  exit 0
fi
if ! FILE_PATHS_JSON=$(printf '%s' "${HOOK_INPUT}" | python3 "${EDIT_EVENT_HELPER}" \
  --host "${HOOK_HOST}" --output paths 2>/dev/null); then
  _breadcrumb "invalid_${HOOK_HOST}_edit_payload"
  exit 0
fi

# ---------------------------------------------------------------------------
# Bump the milestone accumulator (always — this is what /checkin summarizes)
# ---------------------------------------------------------------------------
MILESTONE_PAYLOAD=$(python3 "${SESSION_CACHE_HELPER}" \
  bump-edit \
  --workspace "${PWD}" \
  --file-paths-json "${FILE_PATHS_JSON}" \
  --echo 2>/dev/null || echo "{}")

if [[ -z "${MILESTONE_PAYLOAD}" || "${MILESTONE_PAYLOAD}" == "{}" ]]; then
  _breadcrumb bump_edit_failed
  exit 0
fi

if [[ "${HOOK_HOST}" == "codex" ]]; then
  _breadcrumb codex_local_only
  exit 0
fi

# Claude's network-bearing auto-checkin path requires an established
# slot-scoped governance identity. The local milestone above deliberately does
# not: Codex commonly edits before Stop performs lazy onboarding.
SESSION_LOOKUP="${PLUGIN_ROOT}/scripts/_session_lookup.py"
if [[ -f "${SESSION_LOOKUP}" ]]; then
  # Load the full slotted session JSON for auto_checkin_decision, which needs
  # client_session_id and last_checkin_ts from the cache.
  SESSION_PAYLOAD=$(printf '%s' "${HOOK_INPUT}" | python3 -c "
import json, sys
sys.path.insert(0, '${PLUGIN_ROOT}/scripts')
from _session_lookup import load_session_for_hook
data = load_session_for_hook('${PWD}', sys.stdin.read())
print(json.dumps(data))
" 2>/dev/null || echo "{}")
  # Also eval shell vars for UUID_HINT and SLOT (needed by checkin.py call).
  eval "$(printf '%s' "${HOOK_INPUT}" | python3 "${SESSION_LOOKUP}" --workspace "${PWD}" 2>/dev/null || true)"
else
  SESSION_PAYLOAD=$(python3 "${SESSION_CACHE_HELPER}" get session --workspace "${PWD}" 2>/dev/null || echo "{}")
fi

if [[ -z "${SESSION_PAYLOAD}" || "${SESSION_PAYLOAD}" == "{}" ]]; then
  _breadcrumb no_session_payload
  exit 0
fi

# ---------------------------------------------------------------------------
# Auto-checkin decision
# ---------------------------------------------------------------------------
if [[ "${UNITARES_AUTO_CHECKIN_ENABLED:-1}" == "0" ]]; then
  _breadcrumb auto_checkin_disabled
  exit 0
fi

EDIT_THRESHOLD="${UNITARES_AUTO_CHECKIN_EDITS:-5}"
SECS_THRESHOLD="${UNITARES_AUTO_CHECKIN_SECS:-600}"

DECISION_HELPER=""
for candidate in \
  "${PLUGIN_ROOT}/scripts/auto_checkin_decision.py" \
  "${PLUGIN_ROOT}/scripts/client/auto_checkin_decision.py"
do
  if [[ -f "${candidate}" ]]; then
    DECISION_HELPER="${candidate}"
    break
  fi
done

if [[ -z "${DECISION_HELPER}" ]]; then
  _breadcrumb no_decision_helper
  exit 0
fi

DECISION=$(python3 "${DECISION_HELPER}" \
  --session-json "${SESSION_PAYLOAD}" \
  --milestone-json "${MILESTONE_PAYLOAD}" \
  --edit-threshold "${EDIT_THRESHOLD}" \
  --secs-threshold "${SECS_THRESHOLD}" 2>/dev/null || echo "{}")

FIRE=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('fire', False))" "${DECISION}" 2>/dev/null || echo "False")
if [[ "${FIRE}" != "True" ]]; then
  # Pull the milestone counters out of the decision so under-threshold
  # breadcrumbs are quantitative (e.g. edits=2/5, elapsed=87s/300s).
  THRESH_DETAIL=$(python3 -c "
import json, sys
try:
    d = json.loads(sys.argv[1])
    print(f\"edits={d.get('edit_count', 0)} files={d.get('file_count', 0)}\")
except Exception:
    pass
" "${DECISION}" 2>/dev/null || true)
  _breadcrumb "under_threshold ${THRESH_DETAIL}"
  exit 0
fi

# ---------------------------------------------------------------------------
# Fire process_agent_update — routes through scripts/checkin.py so it gets
# redaction, logging, the kill switch, and metadata tagging on equal footing
# with session-start/stop/end check-ins.
# ---------------------------------------------------------------------------
CLIENT_SESSION_ID=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('client_session_id',''))" "${DECISION}" 2>/dev/null || echo "")
RESPONSE_TEXT=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('response_text',''))" "${DECISION}" 2>/dev/null || echo "")
COMPLEXITY=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('complexity',0.3))" "${DECISION}" 2>/dev/null || echo "0.3")

if [[ -z "${CLIENT_SESSION_ID}" ]]; then
  _breadcrumb no_credentials
  exit 0
fi

# SLOT was derived before session lookup, so the slotless path emits a
# visible [SLOTLESS_SKIP] breadcrumb instead of disappearing as a generic
# no_session_payload exit.
UUID_HINT="${UUID:-}"

MILESTONE_REVISION=$(python3 -c "
import json, sys
try:
    print(int(json.loads(sys.argv[1]).get('revision')))
except Exception:
    pass
" "${MILESTONE_PAYLOAD}" 2>/dev/null || true)
if [[ ! "${MILESTONE_REVISION}" =~ ^[0-9]+$ ]]; then
  _breadcrumb delivery_missing_revision
  exit 0
fi

# Claude can launch multiple asynchronous PostToolUse handlers together. Claim
# one workspace-wide delivery slot before crossing the network so two edits
# that cross the same threshold cannot both submit. The short expiry recovers
# a hook killed before its owner-checked release runs.
DELIVERY_OWNER="${HOOK_HOST}:${SLOT}:${MILESTONE_REVISION}:$$:${RANDOM:-0}"
DELIVERY_CLAIM=$(python3 "${SESSION_CACHE_HELPER}" \
  claim-milestone-delivery \
  --workspace "${PWD}" \
  --revision "${MILESTONE_REVISION}" \
  --owner "${DELIVERY_OWNER}" \
  --ttl "${UNITARES_AUTO_CHECKIN_CLAIM_TTL_S:-30}" \
  --echo 2>/dev/null || echo "{}")
DELIVERY_CLAIMED=$(python3 -c \
  "import json,sys; print(json.loads(sys.argv[1]).get('claimed', False))" \
  "${DELIVERY_CLAIM}" 2>/dev/null || echo "False")
if [[ "${DELIVERY_CLAIMED}" != "True" ]]; then
  _breadcrumb auto_checkin_already_in_flight
  exit 0
fi

_release_delivery_claim() {
  python3 "${SESSION_CACHE_HELPER}" \
    release-milestone-delivery \
    --workspace "${PWD}" \
    --owner "${DELIVERY_OWNER}" >/dev/null 2>&1 || true
}
trap _release_delivery_claim EXIT

# scripts/checkin.py forwards UNITARES_HTTP_API_TOKEN as a Bearer token when set.
python3 "${PLUGIN_ROOT}/scripts/checkin.py" \
  --event auto_edit \
  --response-text "${RESPONSE_TEXT}" \
  --complexity "${COMPLEXITY}" \
  --epistemic-class substrate_interpretation \
  --client-session-id "${CLIENT_SESSION_ID}" \
  --uuid "${UUID_HINT}" \
  --slot "${SLOT}" \
  --require-delivery \
  >/dev/null 2>&1
CHECKIN_STATUS=$?
if [[ "${CHECKIN_STATUS}" -ne 0 ]]; then
  _breadcrumb "auto_checkin_not_delivered status=${CHECKIN_STATUS}"
  exit 0
fi

# Reset the accumulator + stamp last_checkin_ts only after checkin.py confirms
# delivery. If another subagent bumped the shared
# milestone while the check-in was in flight, the revision mismatch preserves
# that newer edit for the next turn instead of silently erasing it.
python3 "${SESSION_CACHE_HELPER}" \
  reset-milestone \
  --workspace "${PWD}" \
  --expected-revision "${MILESTONE_REVISION}" >/dev/null 2>&1 || true

NOW_EPOCH=$(python3 -c "import time; print(int(time.time()))")
# Slot-scoped milestone-timestamp write (S20.1a). Without --slot the helper
# would target flat session.json, which the post-PR-19 session-start hook
# deliberately ignores — the auto-checkin forcing function depends on this
# stamp being readable from the slotted cache the next post-edit fire reads.
# SLOT is guaranteed non-empty here (slotless path exits at line ~210).
python3 "${SESSION_CACHE_HELPER}" \
  set session \
  --workspace "${PWD}" \
  --slot "${SLOT}" \
  --merge \
  --stamp \
  --json "{\"last_checkin_ts\": ${NOW_EPOCH}}" >/dev/null 2>&1 || true

exit 0
