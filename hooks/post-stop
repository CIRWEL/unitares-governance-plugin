#!/usr/bin/env bash
# UNITARES Governance Plugin — Stop hook
#
# Fires once per host turn (when the client stops emitting actions).
# Reads the Stop hook JSON payload on stdin, builds a turn summary,
# submits a process_agent_update via scripts/checkin.py, exits fast.
#
# Claude invokes this asynchronously. Codex invokes it synchronously with
# bounded onboard and check-in budgets below the manifest's outer timeout.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi
# Codex treats empty or plain-text stdout from a successful Stop hook as an
# invalid response. Emit one neutral JSON object on every Codex exit path;
# Claude's asynchronous Stop hook remains silent.
_emit_codex_stop_output() {
  [[ "${HOOK_HOST}" == "codex" ]] && printf '{}\n'
}
trap _emit_codex_stop_output EXIT

HOST_MODEL_TYPE="codex"
[[ "${HOOK_HOST}" == "claude" ]] && HOST_MODEL_TYPE="claude-code"

# Codex Stop has a 30-second outer timeout. Keep network work at or below
# 20 seconds so payload normalization, cache I/O, and process startup retain
# a meaningful margin. Operator overrides may lower these caps, never raise
# them for Codex. Claude's asynchronous hook keeps the configured defaults.
CODEX_ONBOARD_TIMEOUT_CAP="5"
CODEX_CHECKIN_TIMEOUT_CAP="15"

_timeout_at_most() {
  python3 - "$1" "$2" <<'PY' 2>/dev/null || printf '%s\n' "$2"
import math
import sys

cap = float(sys.argv[2])
try:
    value = float(sys.argv[1])
except (TypeError, ValueError):
    value = cap
if not math.isfinite(value) or value <= 0:
    value = cap
print(f"{min(value, cap):g}")
PY
}

DEFAULTS_FILE=""
for candidate in \
  "${PLUGIN_ROOT}/config/defaults.env" \
  "${PLUGIN_ROOT}/config/client/defaults.env"
do
  if [[ -f "${candidate}" ]]; then
    DEFAULTS_FILE="${candidate}"
    break
  fi
done

SERVER_URL_OVERRIDE="${UNITARES_SERVER_URL-}"
CHECKINS_OVERRIDE="${UNITARES_CHECKINS-}"
CHECKIN_LOG_OVERRIDE="${UNITARES_CHECKIN_LOG-}"
AUTO_ONBOARD_OVERRIDE="${UNITARES_AUTO_ONBOARD-}"
DISABLE_AUTO_ONBOARD_OVERRIDE="${UNITARES_DISABLE_AUTO_ONBOARD-}"
AGENT_NAME_OVERRIDE="${UNITARES_AGENT_NAME-}"
AGENT_PREFIX_OVERRIDE="${UNITARES_AGENT_PREFIX-}"
MODEL_TYPE_OVERRIDE="${UNITARES_MODEL_TYPE-}"
AUTO_ONBOARD_TIMEOUT_OVERRIDE="${UNITARES_AUTO_ONBOARD_TIMEOUT-}"
if [[ -n "${DEFAULTS_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${DEFAULTS_FILE}" 2>/dev/null || true
fi
if [[ -n "${SERVER_URL_OVERRIDE}" ]]; then
  UNITARES_SERVER_URL="${SERVER_URL_OVERRIDE}"
fi
if [[ -n "${CHECKINS_OVERRIDE}" ]]; then
  UNITARES_CHECKINS="${CHECKINS_OVERRIDE}"
fi
if [[ -n "${CHECKIN_LOG_OVERRIDE}" ]]; then
  UNITARES_CHECKIN_LOG="${CHECKIN_LOG_OVERRIDE}"
fi
if [[ -n "${AUTO_ONBOARD_OVERRIDE}" ]]; then
  UNITARES_AUTO_ONBOARD="${AUTO_ONBOARD_OVERRIDE}"
fi
if [[ -n "${DISABLE_AUTO_ONBOARD_OVERRIDE}" ]]; then
  UNITARES_DISABLE_AUTO_ONBOARD="${DISABLE_AUTO_ONBOARD_OVERRIDE}"
fi
if [[ -n "${AGENT_NAME_OVERRIDE}" ]]; then
  UNITARES_AGENT_NAME="${AGENT_NAME_OVERRIDE}"
fi
if [[ -n "${AGENT_PREFIX_OVERRIDE}" ]]; then
  UNITARES_AGENT_PREFIX="${AGENT_PREFIX_OVERRIDE}"
elif [[ "${HOOK_HOST}" == "codex" ]]; then
  UNITARES_AGENT_PREFIX="codex"
fi
if [[ -n "${MODEL_TYPE_OVERRIDE}" ]]; then
  UNITARES_MODEL_TYPE="${MODEL_TYPE_OVERRIDE}"
elif [[ "${HOOK_HOST}" == "codex" ]]; then
  UNITARES_MODEL_TYPE="codex"
fi
if [[ -n "${AUTO_ONBOARD_TIMEOUT_OVERRIDE}" ]]; then
  UNITARES_AUTO_ONBOARD_TIMEOUT="${AUTO_ONBOARD_TIMEOUT_OVERRIDE}"
fi
SERVER_URL="${UNITARES_SERVER_URL:-http://localhost:8767}"
ONBOARD_TIMEOUT="${UNITARES_AUTO_ONBOARD_TIMEOUT:-10}"
CHECKIN_TIMEOUT="${UNITARES_CHECKIN_TIMEOUT:-20}"
if [[ "${HOOK_HOST}" == "codex" ]]; then
  ONBOARD_TIMEOUT="$(_timeout_at_most "${ONBOARD_TIMEOUT}" "${CODEX_ONBOARD_TIMEOUT_CAP}")"
  CHECKIN_TIMEOUT="$(_timeout_at_most "${CHECKIN_TIMEOUT}" "${CODEX_CHECKIN_TIMEOUT_CAP}")"
fi

# Read stdin once for host normalization and session-cache lookup.
PAYLOAD=$(cat 2>/dev/null || echo "{}")
[[ -z "${PAYLOAD}" ]] && PAYLOAD="{}"

STOP_EVENT_HELPER="${PLUGIN_ROOT}/scripts/stop_hook_event.py"
if [[ ! -f "${STOP_EVENT_HELPER}" ]]; then
  exit 0
fi
if ! STOP_EVENT=$(printf '%s' "${PAYLOAD}" | python3 "${STOP_EVENT_HELPER}" \
  --host "${HOOK_HOST}" 2>/dev/null); then
  exit 0
fi

_stop_field() {
  python3 - "$1" "${STOP_EVENT}" <<'PY' 2>/dev/null || true
import json, sys
field = sys.argv[1]
try:
    payload = json.loads(sys.argv[2])
except Exception:
    payload = {}
value = payload.get(field, "")
print(value if value is not None else "")
PY
}

# Resolve slot-aware session cache via shared helper.
SESSION_LOOKUP="${PLUGIN_ROOT}/scripts/_session_lookup.py"
if [[ ! -f "${SESSION_LOOKUP}" ]]; then
  exit 0
fi
eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${PWD}")"

# Codex has no failed-tool post hook. Reclaim only this session's unused
# PreToolUse check-in snapshots at the synchronous turn boundary; snapshots
# from other concurrent sessions in the workspace remain untouched.
SNAPSHOT_SLOT=""
SLOT_HELPER="${PLUGIN_ROOT}/scripts/_slot_from_stdin.py"
if [[ "${HOOK_HOST}" == "codex" && -f "${SLOT_HELPER}" ]]; then
  SNAPSHOT_SLOT=$(printf '%s' "${PAYLOAD}" | python3 "${SLOT_HELPER}" 2>/dev/null || true)
fi
if [[ "${HOOK_HOST}" == "codex" && -n "${SNAPSHOT_SLOT}" ]]; then
  SESSION_CACHE_HELPER="${PLUGIN_ROOT}/scripts/session_cache.py"
  if [[ -f "${SESSION_CACHE_HELPER}" ]]; then
    python3 "${SESSION_CACHE_HELPER}" discard-milestone-snapshots \
      --workspace "${PWD}" \
      --slot "${SNAPSHOT_SLOT}" >/dev/null 2>&1 || true
  fi
fi

# If the agent did not explicitly onboard before the turn ended, provision a
# slot-scoped identity now so the turn can still produce a real check-in.
# This is harness-managed attribution for the host process, not an
# agent-authored claim. onboard_helper.py owns the safety constraints:
# force_new=true, per-slot name scoping, lineage via parent_agent_id, no
# persisted continuity token.
CHECKINS_MODE="$(printf '%s' "${UNITARES_CHECKINS:-on}" | tr '[:upper:]' '[:lower:]')"
AUTO_ONBOARD_MODE="$(printf '%s' "${UNITARES_AUTO_ONBOARD:-on}" | tr '[:upper:]' '[:lower:]')"
DISABLE_AUTO_ONBOARD="$(printf '%s' "${UNITARES_DISABLE_AUTO_ONBOARD:-0}" | tr '[:upper:]' '[:lower:]')"
if [[ -z "${CSID:-}" && -n "${RAW_SLOT:-}" \
      && "${CHECKINS_MODE}" != "off" \
      && "${AUTO_ONBOARD_MODE}" != "0" \
      && "${AUTO_ONBOARD_MODE}" != "off" \
      && "${AUTO_ONBOARD_MODE}" != "false" \
      && "${AUTO_ONBOARD_MODE}" != "no" \
      && "${DISABLE_AUTO_ONBOARD}" != "1" \
      && "${DISABLE_AUTO_ONBOARD}" != "true" \
      && "${DISABLE_AUTO_ONBOARD}" != "on" ]]; then
  ONBOARD_HELPER="${PLUGIN_ROOT}/scripts/onboard_helper.py"
  if [[ -f "${ONBOARD_HELPER}" ]]; then
    WORKSPACE_NAME="$(basename "${PWD}")"
    AGENT_NAME="${UNITARES_AGENT_NAME:-${UNITARES_AGENT_PREFIX:-${HOOK_HOST}}-${WORKSPACE_NAME}}"
    MODEL_TYPE="${UNITARES_MODEL_TYPE:-${HOST_MODEL_TYPE}}"
    # Resume anchor (UNITARES_CLIENT_SESSION_ID, e.g. "agent:/thread-<id>") is
    # honored only when the spawner also declares UNITARES_ORCHESTRATED=1. That
    # fail-closed marker lets headless orchestrated turn-children resume one
    # identity across turns while a leaked bare anchor in an interactive shell
    # falls back to normal fresh-mint behavior.
    python3 "${ONBOARD_HELPER}" \
      --server-url "${SERVER_URL}" \
      --name "${AGENT_NAME}" \
      --model-type "${MODEL_TYPE}" \
      --workspace "${PWD}" \
      --slot "${RAW_SLOT}" \
      --client-session-id "${UNITARES_CLIENT_SESSION_ID:-}" \
      --timeout "${ONBOARD_TIMEOUT}" \
      >/dev/null 2>&1 || true
    eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${PWD}")"
  fi
fi

# No onboarded identity (no CSID) after lazy onboarding → don't go dark. Emit
# one identity-free substrate FLOOR observation: a measurement that this
# session ran, NOT an identity claim. It writes to core.substrate_observations
# via a separate endpoint that never touches the identity path. RAW_SLOT is
# the raw host session_id from stdin, present even when no onboard cache
# exists.
if [[ -z "${CSID:-}" ]]; then
  if [[ -n "${RAW_SLOT:-}" ]]; then
    FLOOR_TOOLS=$(_stop_field floor_tool_count)
    FLOOR_SUMMARY=$(_stop_field floor_summary)
    python3 "${PLUGIN_ROOT}/scripts/substrate_floor.py" \
      --slot "${RAW_SLOT}" \
      --event turn_stop \
      --tool-count "${FLOOR_TOOLS}" \
      --summary "${FLOOR_SUMMARY}" \
      >/dev/null 2>&1 || true
  fi
  exit 0
fi

SUMMARY=$(_stop_field summary)
COMPLEXITY=$(_stop_field complexity)

python3 "${PLUGIN_ROOT}/scripts/checkin.py" \
  --event turn_stop \
  --response-text "${SUMMARY}" \
  --complexity "${COMPLEXITY}" \
  --confidence 0.7 \
  --epistemic-class substrate_interpretation \
  --client-session-id "${CSID}" \
  --uuid "${UUID}" \
  --slot "${SLOT:-${RAW_SLOT:-}}" \
  --timeout "${CHECKIN_TIMEOUT}" \
  >/dev/null 2>&1 || true

exit 0
