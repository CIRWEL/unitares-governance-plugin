{
  "description": "UNITARES lifecycle hooks for Codex. Command hooks are synchronous because Codex does not yet support async handlers.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" pre-edit --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" pre-edit --host codex",
            "timeout": 6
          }
        ]
      },
      {
        "matcher": "mcp__.*__(onboard|start_session|identity|bind_session|process_agent_update|sync_state|get_governance_metrics|check_working_state|outcome_event|record_result|knowledge|search_shared_memory|leave_note|dialectic|request_review|observe|calibration|export|config|agent|self_recovery|archive_orphan_agents|list_tools|describe_tool|health_check)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" pre-governance-call --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" pre-governance-call --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-start --host codex",
            "timeout": 15,
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" session-end --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-end --host codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" post-stop --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-stop --host codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" post-activity --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-activity --host codex",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" post-edit --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-edit --host codex",
            "timeout": 6
          }
        ]
      },
      {
        "matcher": "mcp__.*__(process_agent_update|sync_state)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" post-checkin --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-checkin --host codex",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__(onboard|start_session|identity|bind_session)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" post-identity --host codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-identity --host codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
