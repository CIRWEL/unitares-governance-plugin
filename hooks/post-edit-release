#!/usr/bin/env bash
# Synchronous PostToolUse lease cleanup for Claude and Codex. This is separate
# from the milestone/check-in hook so cache or slot failures there cannot skip
# release, and a later edit cannot race the prior edit's lease cleanup.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi

for candidate in \
  "${PLUGIN_ROOT}/config/defaults.env" \
  "${PLUGIN_ROOT}/config/client/defaults.env"
do
  if [[ -f "${candidate}" ]]; then
    # shellcheck source=/dev/null
    source "${candidate}" 2>/dev/null || true
    break
  fi
done

HOOK_INPUT=""
if [[ ! -t 0 ]]; then
  HOOK_INPUT=$(cat 2>/dev/null) || true
fi

HELPER="${PLUGIN_ROOT}/scripts/file_lease_hook.py"
if [[ -f "${HELPER}" ]]; then
  printf '%s' "${HOOK_INPUT}" | python3 "${HELPER}" release-edit \
    --workspace "${PWD}" --host "${HOOK_HOST}" >/dev/null 2>&1 || true
fi

exit 0
